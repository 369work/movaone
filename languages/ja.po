#. Theme Name of the theme
#: style.css:2 inc/theme-options.php:20
msgid "Movaone"
msgstr "Movaone"

#. Theme URI of the theme
#: style.css:3
msgid "https://369theme.com/themes/movaone"
msgstr "https://369theme.com/themes/movaone"

#. Description of the theme
#: style.css:6
msgid "Movaone is a mobile-first WordPress theme with a clean Nordic-inspired design. Features a unique two-column layout with a fixed left panel and a scrollable right content area, fully customizable via the WordPress Customizer."
msgstr "Movaone は、北欧風のすっきりとしたデザインの、モバイルファーストな WordPress テーマです。左に固定したパネルと、スクロールできる右のコンテンツエリアからなる独自の2カラムレイアウトが特長で、WordPress のカスタマイザーから自由にカスタマイズできます。"

#. Author of the theme
#: style.css:4
msgid "miroku"
msgstr "miroku"

#. Author URI of the theme
#: style.css:5
msgid "https://profiles.wordpress.org/369work/"
msgstr "https://profiles.wordpress.org/369work/"

